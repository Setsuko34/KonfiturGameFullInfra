# ═══════════════════════════════════════════════
.appwrite/

# ═══════════════════════════════════════════════
# CI — fichiers temporaires générés localement
# ═══════════════════════════════════════════════
/tmp/
.env.ci
trivy-results.sarif
trivy-fs-results.sarif
/docs/superpowers/
/docs/Doc/
.obsidian

# Identifiants du dashboard Traefik (htpasswd) — jamais versionnés
traefik/dashboard-users

# Metriques generees au runtime par backup.sh et health-check.sh
# (le repertoire est versionne pour le montage Docker, pas son contenu)
monitoring/textfile/*.prom
